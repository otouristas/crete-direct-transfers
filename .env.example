# Public Supabase browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=

# Application
VITE_SITE_URL=http://localhost:3000
VITE_DEMO_BOOKINGS=false
VITE_CONTACT_PHONE=
VITE_WHATSAPP_NUMBER=
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_X=
# Enable only after review records and their source have been verified.
VITE_REVIEWS_VERIFIED=false
VITE_BUSINESS_METRICS_VERIFIED=false
# Named driver profiles (/drivers) stay noindex and out of the sitemap, footer
# and cross-links until every published driver has consented and the ratings
# and transfer counts are backed by real records.
VITE_DRIVER_PROFILES_VERIFIED=false

# Transactional services
RESEND_API_KEY=
# Sender shown on transactional email, e.g. "TransferAround <noreply@transferaround.com>"
RESEND_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OUTBOX_CRON_SECRET=
DISPATCH_CRON_SECRET=

# Touristas AI assistant (server-side only). Without a key the assistant
# answers in offline mode with quote tools but no free-form chat.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional live integrations (client-side, public values only)
# Self-hosted or paid OSRM endpoint for live-trip routing; the public demo
# server is used when unset.
VITE_OSRM_URL=
# Flight status provider; without both values the booking page shows the
# flight as tracked by the driver, with no live ETA.
VITE_FLIGHT_API_URL=
VITE_FLIGHT_API_KEY=

# Push notifications
EXPO_ACCESS_TOKEN=

# Place imagery (build-time only — never expose with a VITE_ prefix).
# Populates src/data/place-images.json via `npm run images:pexels`.
# Get a key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional analytics
VITE_PLAUSIBLE_DOMAIN=
