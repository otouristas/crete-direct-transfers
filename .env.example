# Public (Vite) — use publishable key from Supabase API Keys
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Legacy alias still read by some server paths
VITE_SUPABASE_ANON_KEY=
VITE_PLAUSIBLE_DOMAIN=
VITE_OSRM_URL=
# Legacy — live flight lookups use server FLIGHT_API_KEY (do not put secrets in VITE_*)
VITE_FLIGHT_API_URL=
VITE_FLIGHT_API_KEY=
VITE_DEMO_BOOKINGS=false

# Server-only (Cloudflare / Node)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Dashboard "secret" key (sb_secret_…) or legacy service_role JWT
SUPABASE_SERVICE_ROLE_KEY=
# Aviationstack access key for realtime flight status / wait-clock ETA.
# Supabase Dashboard secrets do NOT auto-inject here — copy the same value into this app env.
FLIGHT_API_KEY=
# Optional override (default https://api.aviationstack.com/v1)
FLIGHT_API_URL=
# Nuitee Connect (LiteAPI) — hotels + flights. Same value as Supabase Edge secret LITE_API_KEY.
# Never put this in VITE_* or EXPO_PUBLIC_*.
LITE_API_KEY=
# Alias also accepted by server client:
# LITEAPI_API_KEY=
RESEND_API_KEY=
RESEND_FROM=TransferAround <noreply@transferaround.com>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mobile checkout uses the same authenticated website API; keep Stripe secrets server-only.
# Connect Express return/refresh (defaults to SITE_URL driver/partner pages)
STRIPE_CONNECT_REFRESH_URL=
STRIPE_CONNECT_RETURN_URL=
# Apple Pay / Google Pay: enable in Stripe Dashboard → Payment methods.
# Add Apple Pay domains for transferaround.com (and preview hosts). Checkout
# leaves payment methods automatic so wallets appear when Dashboard allows them.
# Supabase Dashboard secrets do NOT auto-inject here — copy STRIPE_* into this app env.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
AI_API_KEY=
# Touristas AI uses OPENAI_API_KEY (or AI_API_KEY). Without it, resolve_trip quotes still work offline.

# Cron: POST /api/dispatch/expire with Authorization: Bearer <secret>
DISPATCH_CRON_SECRET=

# Mobile store badges (optional until apps are published)
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=

# Run every minute with Authorization: Bearer DISPATCH_CRON_SECRET
# POST /api/events/process (durable paid-booking and notification outbox)
# POST /api/dispatch/expire (offer expiry and reassignment)

# Optional raster tile provider; default is attributed OpenStreetMap.
VITE_MAP_TILE_URL=

# Optional hotel/flight provider checkout; enable only after provider fulfillment testing.
TRAVEL_BOOKING_ENABLED=false
VITE_TRAVEL_BOOKING_ENABLED=false
