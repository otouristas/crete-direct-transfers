{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crete-direct-transfers-preview",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  }
}
